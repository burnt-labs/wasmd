#!/usr/bin/env bash
# xion-sync: bring an upstream CosmWasm/wasmd tag onto its xion line branch,
# build and test it, and (after the PR has landed) cut the xion tag.
#
#   scripts/xion-sync [--dry-run] [--keep] [--skip-tests] [--base <ref>] [--new-line] [--from-line <ref>] <upstream-tag>
#   scripts/xion-sync --tag [--dry-run] [--skip-tests] <upstream-tag>
#
# Prepare mode (default) works in a throwaway worktree:
#   - same line (xion/vX.Y.x exists): branch from it and merge the upstream tag
#     with a signed merge commit;
#   - new line (xion/vX.Y.x missing): branch from the upstream tag and
#     cherry-pick the patch stack of --from-line (default: origin/xion/main),
#     then check each picked patch against its source by patch-id
#     (--new-line takes this path even when the line branch exists);
#   - go build ./... and the x/wasm tests;
#   - without --dry-run, push sync/<upstream-tag> and print the PR command.
#     Land that PR with a merge commit, never squash or rebase (see AGENTS.md).
#
# Tag mode cuts vX.Y.Z-xion.N on the head of origin/xion/vX.Y.x, signed and
# annotated, after checking the upstream tag is an ancestor and the build and
# tests pass, then waits for proxy.golang.org to resolve it. N is the next
# number not used by any tag on origin or any version the Go proxy has seen.
#
# git rerere is enabled for the repository so conflict resolutions are reused.
set -euo pipefail

UPSTREAM_URL=https://github.com/CosmWasm/wasmd.git
MODULE=github.com/burnt-labs/wasmd
TEST_TAGS='ledger test_ledger_mock'

mode=prepare dry=0 keep=0 skip_tests=0 base='' from_line='' new_line=0
die() { echo "xion-sync: $*" >&2; exit 1; }
say() { echo "==> $*"; }
usage() { sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1 ;;
    --keep) keep=1 ;;
    --tag) mode=tag ;;
    --skip-tests) skip_tests=1 ;;
    --base) base=${2:?}; shift ;;
    --from-line) from_line=${2:?}; shift ;;
    --new-line) new_line=1 ;;
    -h|--help) usage 0 ;;
    -*) die "unknown option $1" ;;
    *) [ -z "${utag:-}" ] || die "one upstream tag only"; utag=$1 ;;
  esac
  shift
done
[ -n "${utag:-}" ] || usage 1
if [ "$mode" = tag ] && [ "$skip_tests" = 1 ] && [ "$dry" = 0 ]; then
  die "--skip-tests is only allowed with --dry-run in tag mode: a release tag needs a passing test run"
fi
[[ $utag =~ ^v([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || die "expected an upstream tag like v0.70.5, got $utag"
line="xion/v${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.x"

repo=$(git rev-parse --show-toplevel)
cd "$repo"
git config rerere.enabled true
git config rerere.autoupdate true

say "fetching origin and the upstream release tags"
git fetch -q origin '+refs/heads/*:refs/remotes/origin/*' --tags
# All upstream release tags: the line base and the patch stack are found by
# excluding upstream history, which needs every upstream tag locally.
git fetch -q "$UPSTREAM_URL" '+refs/tags/v*:refs/tags/v*' --no-tags
git rev-parse -q --verify "refs/tags/$utag" >/dev/null || die "upstream has no tag $utag"
utag_commit=$(git rev-parse "$utag^{commit}")

is_upstream_tag() { [[ $1 =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; }

# The upstream tag a line branch was started from: walk its first-parent
# history and stop at the first commit that carries an upstream tag. Upstream
# tags merged in later sit on second parents, so they are never on this path.
line_base_tag() {
  local head=$1 c t
  for c in $(git rev-list --first-parent "$head"); do
    for t in $(git tag --points-at "$c"); do
      if is_upstream_tag "$t"; then echo "$t"; return; fi
    done
  done
  die "no upstream tag found on the first-parent history of $head"
}

build_and_test() {
  say "go build ./..."
  go build -mod=readonly ./...
  if [ "$skip_tests" = 1 ]; then say "skipping tests (--skip-tests)"; return; fi
  say "go test ./x/wasm/... (tags: $TEST_TAGS)"
  go test -mod=readonly -count=1 -tags="$TEST_TAGS" ./x/wasm/...
  # What gets pushed or tagged is the commit, so the checks must not have
  # needed any change to it.
  [ -z "$(git status --porcelain)" ] || die "the build or tests changed the worktree:
$(git status --short)"
}

# Next free -xion.N for $utag. Both lookups must succeed: a name that is gone
# from GitHub but cached by the Go proxy can never be reused, so a failed
# lookup stops the script instead of guessing.
next_tag() {
  local prefix="$utag-xion." n max=0 remote proxy
  remote=$(git ls-remote --tags origin "refs/tags/$prefix*") || die "could not list tags on origin"
  proxy=$(curl -fsS "https://proxy.golang.org/$MODULE/@v/list") || die "could not read the Go proxy version list"
  for n in $(printf '%s\n' "$remote" | sed -n "s|.*refs/tags/$prefix\([0-9]*\)\$|\1|p") \
           $(printf '%s\n' "$proxy" | sed -n "s|^$prefix\([0-9]*\)\$|\1|p"); do
    [ "$n" -gt "$max" ] && max=$n
  done
  echo "$prefix$((max + 1))"
}

if [ "$mode" = tag ]; then
  git rev-parse -q --verify "refs/remotes/origin/$line" >/dev/null || die "origin has no $line"
  head=$(git rev-parse "origin/$line")
  git merge-base --is-ancestor "$utag_commit" "$head" || die "$utag is not in origin/$line yet; land the sync PR first"
  newest=$(git tag --merged "$head" | grep -E "^${utag%.*}\.[0-9]+\$" | sort -V | tail -1)
  [ "$newest" = "$utag" ] || die "origin/$line already contains upstream $newest; tag that version, not $utag"
  newtag=$(next_tag)
  wt=$(mktemp -d "${TMPDIR:-/tmp}/xion-sync-tag.XXXXXX")
  git worktree add -q --detach "$wt" "$head"
  trap 'git worktree remove --force "$wt"' EXIT
  (cd "$wt" && build_and_test)
  if [ "$dry" = 1 ]; then
    say "dry run: nothing tagged or pushed. Would tag $newtag on origin/$line ($head)"
    exit 0
  fi
  now=$(git ls-remote origin "refs/heads/$line" | cut -f1)
  [ "$now" = "$head" ] || die "origin/$line moved from $head to $now during the checks; run --tag again"
  # A local tag of this name that origin does not have is left over from a
  # failed push: it was never published, so it may be replaced.
  if git rev-parse -q --verify "refs/tags/$newtag" >/dev/null; then
    say "removing the unpublished local tag $newtag from an earlier failed run"
    git tag -d "$newtag" >/dev/null
  fi
  say "tagging $newtag on origin/$line ($head)"
  git tag -s -a -m "$newtag" "$newtag" "$head"
  if ! git push origin "refs/tags/$newtag"; then
    git tag -d "$newtag" >/dev/null
    die "pushing $newtag failed; the local tag is removed, so fix the push and run --tag again"
  fi
  say "waiting for proxy.golang.org to resolve $newtag"
  for _ in $(seq 1 30); do
    if info=$(curl -fsS "https://proxy.golang.org/$MODULE/@v/$newtag.info" 2>/dev/null); then
      echo "$info"
      # proxy.golang.org adds Origin.Hash to .info; the GOPROXY protocol only
      # promises Version and Time, so a missing Hash is not a failure.
      case "$info" in
        *"\"Hash\":\"$head\""*) say "done: $newtag resolves to $head"; exit 0 ;;
        *'"Hash":'*) die "the proxy resolves $newtag to a different commit than $head; do not pin it" ;;
        *) say "done: the proxy serves $newtag (it reports no commit hash to compare)"; exit 0 ;;
      esac
    fi
    sleep 10
  done
  die "pushed $newtag, but the proxy did not resolve it within 5 minutes; check again before anything pins it"
fi

# prepare mode
wt=$(mktemp -d "${TMPDIR:-/tmp}/xion-sync.XXXXXX")
rmdir "$wt"
branch="sync/$utag"
pushed=0
cleanup() {
  if [ "$keep" = 1 ]; then echo "worktree and branch kept at $wt"; return; fi
  git -C "$repo" worktree remove --force "$wt" 2>/dev/null || true
  # An unpushed sync branch would block the next run (worktree add -b).
  if [ "$dry" = 0 ] && [ "$pushed" = 0 ]; then git -C "$repo" branch -q -D "$branch" 2>/dev/null || true; fi
}
# A dry run works on a detached HEAD so it leaves no branch behind.
add_worktree() { # <start-point>
  if [ "$dry" = 0 ] && git rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
    die "branch $branch already exists locally (an earlier run kept it); finish or delete it first"
  fi
  if [ "$dry" = 1 ]; then git worktree add -q --detach "$wt" "$1"; else git worktree add -q -b "$branch" "$wt" "$1"; fi
  trap cleanup EXIT
}

if [ "$new_line" = 1 ]; then
  base=''
elif [ -z "$base" ] && git rev-parse -q --verify "refs/remotes/origin/$line" >/dev/null; then
  base="origin/$line"
fi

if [ -n "$base" ]; then
  say "same line: merging $utag into $base"
  add_worktree "$base"
  cd "$wt"
  if git merge-base --is-ancestor "$utag_commit" HEAD; then
    say "$base already contains $utag; nothing to merge"
  elif ! git merge -S --no-ff -m "Merge upstream CosmWasm/wasmd $utag into $line" "$utag"; then
    git rerere status
    if [ -n "$(git diff --name-only --diff-filter=U)" ]; then
      echo "Conflicts left. Resolve them in $wt, then: git add -A && git commit -S --no-edit" >&2
      keep=1
      exit 2
    fi
    git commit -S --no-edit
  fi
else
  src=${from_line:-origin/xion/main}
  src_base=$(line_base_tag "$src")
  say "new line $line: $utag + the patch stack of $src (our commits since $src_base, without upstream history)"
  add_worktree "$utag_commit"
  cd "$wt"
  # The stack is our commits only: exclude the ancestry of every upstream
  # tag merged into the source line, not just the tag it started from.
  excludes=("^$src_base")
  for t in $(git tag --merged "$src"); do
    if is_upstream_tag "$t"; then excludes+=("^$t"); fi
  done
  stack=$(git rev-list --reverse --no-merges "$src" "${excludes[@]}")
  picked=()
  for c in $stack; do
    if git cherry-pick -S -x "$c"; then
      picked+=("$c:$(git rev-parse HEAD)")
    elif [ -n "$(git diff --name-only --diff-filter=U)" ]; then
      echo "Conflict on $(git log -1 --format='%h %s' "$c"). Resolve in $wt, then: git add -A && git cherry-pick --continue, and pick the rest of the stack by hand." >&2
      keep=1
      exit 2
    elif git diff --cached --quiet; then
      say "skipping $(git log -1 --format='%h %s' "$c"): already in $utag"
      git cherry-pick --skip
      picked+=("$c:skipped")
    else
      say "conflicts in $(git log -1 --format='%h' "$c") were resolved from rerere's recorded resolutions; review its range-diff below"
      git commit -S --no-edit
      picked+=("$c:$(git rev-parse HEAD)")
    fi
  done
  # range-diff takes plain ranges, and the stack is not one, so compare each
  # picked commit with its source by patch-id ("=" same patch, "!" changed).
  say "stack check against $src (= unchanged, ! changed, - already upstream)"
  for pair in "${picked[@]}"; do
    c=${pair%%:*} new_c=${pair#*:}
    if [ "$new_c" = skipped ]; then mark='-'; else
      old_id=$(git show "$c" | git patch-id --stable | cut -d' ' -f1)
      new_id=$(git show "$new_c" | git patch-id --stable | cut -d' ' -f1)
      mark='!'; [ "$old_id" = "$new_id" ] && mark='='
    fi
    printf '%s %.8s -> %.8s %s\n' "$mark" "$c" "$new_c" "$(git log -1 --format=%s "$c")"
  done
  for pair in "${picked[@]}"; do
    c=${pair%%:*} new_c=${pair#*:}
    [ "$new_c" = skipped ] && continue
    if [ "$(git show "$c" | git patch-id --stable | cut -d' ' -f1)" != "$(git show "$new_c" | git patch-id --stable | cut -d' ' -f1)" ]; then
      say "range-diff for changed patch $(git log -1 --format='%h %s' "$c")"
      git --no-pager range-diff --no-color "$c^!" "$new_c^!"
    fi
  done
  # Merge commits are not replayed. A merge may only resolve conflicts in
  # favour of upstream or of an existing patch (AGENTS.md); list the ones
  # whose recorded result differs from git's automatic merge (conflict
  # resolutions or hand edits) so nothing fork-specific hides in them.
  resolved=$(for m in $(git rev-list --merges "$src" "${excludes[@]}"); do
    if [ -n "$(git show --remerge-diff --format= "$m" | head -1)" ]; then git log -1 --format='  %h %s' "$m"; fi
  done)
  if [ -n "$resolved" ]; then
    say "merge commits with conflict resolutions on $src (not replayed; check with git show --remerge-diff <sha> that each only resolves toward upstream or an existing patch):"
    echo "$resolved"
  fi
fi

say "our commits on top of $utag:"
git --no-pager log --oneline --no-merges "$utag..HEAD" | cat
build_and_test

if [ "$dry" = 1 ]; then
  nt=$(cd "$repo" && next_tag)
  say "dry run: nothing pushed or tagged. After the PR lands, the tag would be $nt"
  exit 0
fi

git push -u origin "HEAD:refs/heads/$branch"
pushed=1
if ! git rev-parse -q --verify "refs/remotes/origin/$line" >/dev/null; then
  say "new line: create $line at $utag, then review the stack as a PR into it"
  echo "  git push origin $utag_commit:refs/heads/$line"
  echo "  gh pr create --base $line --head $branch --title \"Start $line: upstream $utag + the xion patch stack\""
  echo "Land it with a merge commit (never squash or rebase), then: scripts/xion-sync --tag $utag"
  echo "Moving xion/main to a new line is not a fast-forward; see AGENTS.md (needs twiceburnt's go)."
elif [ "$(git rev-parse "origin/$line")" = "$(git rev-parse origin/xion/main)" ]; then
  say "$line is the current line: the PR goes to xion/main"
  echo "  gh pr create --base xion/main --head $branch --title \"Sync upstream $utag into $line\""
  echo "Land it with a merge commit (never squash or rebase), then fast-forward the line and tag:"
  echo "  git fetch origin && git push origin origin/xion/main:refs/heads/$line"
  echo "  scripts/xion-sync --tag $utag"
else
  say "$line is an older line: the PR goes to $line"
  echo "  gh pr create --base $line --head $branch --title \"Sync upstream $utag into $line\""
  echo "Land it with a merge commit (never squash or rebase), then: scripts/xion-sync --tag $utag"
fi
